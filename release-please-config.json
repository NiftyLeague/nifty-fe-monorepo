{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "refactor",
      "section": "Maintenance"
    },
    {
      "type": "chore",
      "section": "Maintenance"
    }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "nifty-fe-monorepo"
    },
    "apps/app": {
      "release-type": "node",
      "package-name": "app"
    },
    "apps/docs": {
      "release-type": "node",
      "package-name": "docs"
    },
    "apps/smashers": {
      "release-type": "node",
      "package-name": "smashers"
    },
    "apps/template": {
      "release-type": "node",
      "package-name": "template"
    },
    "apps/web": {
      "release-type": "node",
      "package-name": "web"
    },
    "packages/eslint-config": {
      "release-type": "node",
      "package-name": "@nl/eslint-config"
    },
    "packages/imx-passport": {
      "release-type": "node",
      "package-name": "@nl/imx-passport"
    },
    "packages/playfab": {
      "release-type": "node",
      "package-name": "@nl/playfab"
    },
    "packages/prettier-config": {
      "release-type": "node",
      "package-name": "@nl/prettier-config"
    },
    "packages/theme": {
      "release-type": "node",
      "package-name": "@nl/theme"
    },
    "packages/typescript-config": {
      "release-type": "node",
      "package-name": "@nl/typescript-config"
    },
    "packages/ui": {
      "release-type": "node",
      "package-name": "@nl/ui"
    }
  }
}
