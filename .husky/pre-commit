#!/bin/sh
export PATH="/opt/homebrew/bin:$HOME/.bun/bin:$PATH"

# ── HARD GUARD: never commit env/secret files ──────────────────────────────
# Blocks .env, .env.* (local/dev/prod), .envrc, and common secret files
# even if gitignored (force-add bypass) or misconfigured.
BLOCKED=$(git diff --cached --name-only --diff-filter=ACM | grep -Ei '\.env$|/\.env$|/\.envrc$|\.env\.[a-z0-9]+$|/\.env\.[a-z0-9]+$|\.envrc$|\.secrets$|credentials\.json$|service-account.*\.json$|.*\.pem$|.*\.key$|id_rsa|id_ed25519' || true)

if [ -n "$BLOCKED" ]; then
  echo "🛑 PRE-COMMIT GUARD: refusing to commit env/secret files:"
  echo "$BLOCKED" | sed 's/^/   /'
  echo ""
  echo "These files contain secrets and must NEVER be committed."
  echo "If this is intentional (e.g. .env.example), use 'git commit --no-verify' ONLY after confirming it is safe."
  exit 1
fi
# ─────────────────────────────────────────────────────────────────────────────

bun lint-staged
