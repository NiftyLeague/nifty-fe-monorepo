{
  "name": "@nl/eslint-config",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    "./base": "./base.js",
    "./next-js": "./next.js",
    "./react-internal": "./react-internal.js"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "test": "bun test --project-placeholder eslint-config",
    "test:coverage": "VITEST_SCOPE=packages/eslint-config bun test --project-placeholder eslint-config --coverage",
    "test:watch": "vitest --config ../../vitest.config.ts --project eslint-config"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.10.5",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.64.0"
  }
}
