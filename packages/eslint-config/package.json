    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.10.5",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.64.0"
  }
}
