{
  "name": "@nl/ui",
  "version": "2.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    "./base/*": "./src/components/base/*.tsx",
    "./custom/*": "./src/components/custom/*/index.tsx",
    "./custom/console-game-backdrop": "./src/components/custom/console-game/backdrop.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./class-names": "./src/lib/class-names.ts",
    "./image-sizes": "./src/lib/image-sizes.ts",
    "./number-format": "./src/lib/number-format.ts",
    "./gtm": "./src/lib/gtm/index.tsx",
    "./gtm/constants": "./src/lib/gtm/constants.ts",
    "./gtm/deferred-manager": "./src/lib/gtm/DeferredGoogleTagManager.tsx",
    "./gtm/events": "./src/lib/gtm/events.ts",
    "./gtm/load": "./src/lib/gtm/loadGoogleTagManager.ts",
    "./gtm/telemetry-gate": "./src/lib/gtm/telemetry-gate.ts",
    "./degen-tribes": "./src/lib/degen-tribes.ts",
    "./lib/deferred-activation": "./src/lib/deferred-activation.ts",
    "./lib/deferred-boundary": "./src/lib/deferred-boundary.ts",
    "./lib/fonts/assets/*": "./src/lib/fonts/assets/*",
    "./lib/fonts/*": "./src/lib/fonts/*",
    "./lib/image-attributes": "./src/lib/image-attributes.ts",
    "./utils": "./src/lib/utils.ts",
    "./test-utils": "./src/test-utils.tsx",
    "./postcss.config": "./postcss.config.mjs",
    "./styles.css": "./src/styles/globals.css",
    "./styles/fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "add-component": "bun dlx shadcn@latest add $@",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .storybook",
    "format": "oxfmt .",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "postadd-component": "bun run format",
    "test": "bun test --conditions=browser --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --conditions=browser --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@modular-forms/solid": "^0.25.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.46.0",
    "solid-js": "^1.9.15",
    "solid-sonner": "^0.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "solid-js": "^1.9.15"
  }
}
