{
  "name": "@nl/ui",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "private": true,
  "exports": {
    "./base/*": "./src/components/base/*.tsx",
    "./custom/*": "./src/components/custom/*/index.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./fonts": "./src/lib/fonts/index.ts",
    "./gtm": "./src/lib/gtm/index.tsx",
    "./utils": "./src/lib/utils.ts",
    "./postcss.config": "./postcss.config.mjs",
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "add-component": "bun dlx shadcn@latest add $@",
    "postadd-component": "bun migrate && bun format",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .storybook",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,mdx,json}\" --ignore-path ../../.gitignore",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "migrate": "bun dlx shadcn@latest migrate radix -y",
    "test": "bun test || true",
    "test:coverage": "VITEST_SCOPE=packages/ui bun test --project-placeholder ui --coverage",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@next/third-parties": "^16.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react-hook-form": "^7.82.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2"
  },
  "peerDependencies": {
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
