{
  "name": "@nl/ui",
  "version": "1.0.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "private": true,
  "exports": {
    "./base/*": "./src/components/base/*.tsx",
    "./custom/*": "./src/components/custom/*/index.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./class-names": "./src/lib/class-names.ts",
    "./number-format": "./src/lib/number-format.ts",
    "./fonts": "./src/lib/fonts/index.ts",
    "./fonts/*": "./src/lib/fonts/*.ts",
    "./gtm": "./src/lib/gtm/index.tsx",
    "./gtm/constants": "./src/lib/gtm/constants.ts",
    "./gtm/deferred": "./src/lib/gtm/DeferredAnalytics.tsx",
    "./gtm/events": "./src/lib/gtm/events.ts",
    "./degen-tribes": "./src/lib/degen-tribes.ts",
    "./lib/deferred-activation": "./src/lib/deferred-activation.ts",
    "./utils": "./src/lib/utils.ts",
    "./postcss.config": "./postcss.config.mjs",
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "add-component": "bun dlx shadcn@latest add $@",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .storybook",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,mdx,json}\" --ignore-path ../../.gitignore",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "migrate": "bun dlx shadcn@latest migrate radix -y",
    "postadd-component": "bun migrate && bun format",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
