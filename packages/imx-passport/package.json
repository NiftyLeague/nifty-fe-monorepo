{
  "name": "@nl/imx-passport",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./config.ts",
  "exports": {
    ".": "./config.ts",
    "./types": "./types.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf .turbo",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,mdx,json}\" --ignore-path ../../.gitignore",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@imtbl/sdk": "^2.24.4"
  },
  "peerDependencies": {
    "react": "19.2.8"
  }
}
