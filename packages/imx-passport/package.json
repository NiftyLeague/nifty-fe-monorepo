{
  "name": "@nl/imx-passport",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./config.ts",
  "exports": {
    ".": "./config.ts",
    "./types": "./types.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf .turbo",
    "format": "oxfmt .",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@imtbl/sdk": "^2.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "peerDependencies": {
    "react": "19.2.8"
  }
}
