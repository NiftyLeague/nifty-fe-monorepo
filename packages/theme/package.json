{
  "name": "@nl/theme",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/types/@types/index.d.ts"
    },
    "./types": "./src/types/@types/index.d.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf .turbo",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,mdx,json}\" --ignore-path ../../.gitignore",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "test": "bun test --project-placeholder theme",
    "test:coverage": "VITEST_SCOPE=packages/theme bun test --project-placeholder theme --coverage",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nl/ui": "workspace:*",
    "react-intl": "^10.1.18",
    "stylis-plugin-rtl": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@mui/material-nextjs": "^9.1.1",
    "@mui/system": "^9.2.0",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
