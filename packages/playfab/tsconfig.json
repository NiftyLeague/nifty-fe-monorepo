{
  "extends": "@nl/typescript-config/react-library.json",
  "compilerOptions": {
    "incremental": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*", "../ui/src/@types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test-mock-sdk.ts"
  ]
}
