{
  "name": "@nl/playfab",
  "version": "1.0.8",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    "./api": "./src/api.ts",
    "./api/*": "./src/api/*.ts",
    "./auth/*": "./src/auth/*.ts",
    "./components/*": "./src/components/*/index.tsx",
    "./constants": "./src/constants.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./sdk": "./src/sdk/index.ts",
    "./sdk/client": "./src/sdk/client.ts",
    "./types": "./src/types.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -rf .turbo",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nl/ui": "workspace:*",
    "iron-session": "^9.0.1",
    "solid-js": "^1.9.15",
    "solid-sonner": "^0.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
