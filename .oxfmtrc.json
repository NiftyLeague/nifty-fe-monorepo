{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "ignorePatterns": [
    "**/*.hbs",
    "**/.app",
    "**/.astro",
    "**/.venv",
    "**/.web-images",
    "**/.wrangler",
    "**/astro.wrangler.jsonc",
    "**/build",
    "**/coverage",
    "**/dist",
    "**/node_modules",
    "**/public",
    "**/routeTree.gen.ts",
    "**/wrangler.jsonc",
