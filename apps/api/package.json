{
  "name": "api",
  "version": "1.0.0",
  "description": "Nifty League Contracts API and webhook service",
  "private": true,
  "type": "module",
  "main": "api/index.js",
  "bin": {
    "minty": "commander.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-config.mjs && node scripts/copy-api-app.mjs",
    "vercel-build": "bun run build",
    "clean": "rm -rf dist api/.app api/config .turbo coverage",
    "dev": "NODE_CONFIG_TS_DIR=config tsx watch src/index.ts",
    "start": "node api/index.js",
    "test": "bun scripts/run-tests-isolated.ts",
    "test:unit": "bun scripts/run-tests-isolated.ts src --exclude src/index.integration.test.ts",
    "test:integration": "bun test src/index.integration.test.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --isolate",
    "test:live": "RUN_LIVE_TESTS=1 bun test test/smoke/api.contract.test.ts --testTimeout=30000",
    "audit:endpoints": "node scripts/audit-endpoints.mjs",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "deploy": "node scripts/vercel-build.mjs --prod && npx vercel deploy --prebuilt --prod --scope niftyleague",
    "onboarding:user-registration": "tsx src/imx/onboarding/1-user-registration.ts",
    "onboarding:create-collection": "tsx src/imx/onboarding/3-create-collection.ts",
    "onboarding:add-metadata-schema": "tsx src/imx/onboarding/4-add-metadata-schema.ts",
    "admin:update-metadata-schema": "tsx src/imx/admin/update-metadata-schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "axios": "^1.19.0",
    "bn.js": "^5.2.5",
    "body-parser": "^2.3.0",
    "chalk": "^6.0.0",
    "cors": "^2.8.6",
    "enc-utils": "^3.0.0",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "json-colorizer": "^3.0.1",
    "kubo-rpc-client": "^7.1.0",
    "multiformats": "^14.0.5",
    "node-config-ts": "^3.3.1",
    "node-fetch": "^3.3.2",
    "starknet": "^10.0.2",
    "ts-command-line-args": "^2.5.1",
    "uint8arrays": "^6.1.1"
  },
  "devDependencies": {
    "@nl/eslint-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/bn.js": "^5.1.6",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/node-fetch": "^2.6.13",
    "commander": "^15.0.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "24.18.0"
  }
}
