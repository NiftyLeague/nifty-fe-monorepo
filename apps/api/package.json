{
  "name": "api",
  "version": "2.0.0",
  "private": true,
  "description": "Nifty League Contracts API and webhook service",
  "bin": {
    "minty": "commander.ts"
  },
  "type": "module",
  "main": "api/index.js",
  "scripts": {
    "admin:update-metadata-schema": "tsx src/imx/admin/update-metadata-schema.ts",
    "audit:endpoints": "node scripts/audit-endpoints.mjs",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-config.mjs && node scripts/copy-contract-deployments.mjs",
    "clean": "rm -rf dist api/.app api/config .turbo coverage",
    "dev": "NODE_CONFIG_TS_DIR=config node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "onboarding:add-metadata-schema": "tsx src/imx/onboarding/4-add-metadata-schema.ts",
    "onboarding:create-collection": "tsx src/imx/onboarding/3-create-collection.ts",
    "onboarding:user-registration": "tsx src/imx/onboarding/1-user-registration.ts",
    "start": "NODE_CONFIG_TS_DIR=config node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs src/index.ts",
    "test": "bun scripts/run-tests-isolated.ts",
    "test:coverage": "bun test --coverage --isolate",
    "test:integration": "bun test src/index.integration.test.ts",
    "test:live": "bun test ./test/smoke/api.contract.live.ts --testTimeout=30000",
    "test:unit": "bun scripts/run-tests-isolated.ts src --exclude src/index.integration.test.ts",
    "test:watch": "bun test --watch",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "build:cloudflare": "echo \"api bundles from source at deploy time\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@nl/contracts": "workspace:*",
    "bn.js": "^5.2.5",
    "body-parser": "^2.3.0",
    "chalk": "^6.0.0",
    "cors": "^2.8.6",
    "enc-utils": "^3.0.0",
    "ethers": "~6.17.0",
    "express": "^5.2.1",
    "json-colorizer": "^3.0.1",
    "kubo-rpc-client": "^7.1.0",
    "multiformats": "^14.0.5",
    "node-config-ts": "^3.3.1",
    "starknet": "^10.0.2",
    "ts-command-line-args": "^2.5.1",
    "uint8arrays": "^6.1.1"
  },
  "devDependencies": {
    "@nl/typescript-config": "workspace:*",
    "@types/bn.js": "^5.1.6",
    "@types/body-parser": "^1.19.6",
    "@types/bun": "^1.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "commander": "^15.0.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "24.18.0"
  }
}
