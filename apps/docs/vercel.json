{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "codex/*": false,
      "**": false,
      "main": true
    }
  },
  "installCommand": "bunx bun@1.4.0 install --frozen-lockfile",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs",
  "redirects": [
    {
      "source": "/docs/archive/rentals/rentals",
      "destination": "https://niftyleague.com/docs/archive/rentals",
      "permanent": true
    },
    {
      "source": "/archive/rentals/rentals",
      "destination": "https://niftyleague.com/docs/archive/rentals",
      "permanent": true
    },
    {
      "source": "/docs/overview/games/niftyworld/niftyworld",
      "destination": "https://niftyleague.com/docs/overview/games/niftyworld",
      "permanent": true
    },
    {
      "source": "/overview/games/niftyworld/niftyworld",
      "destination": "https://niftyleague.com/docs/overview/games/niftyworld",
      "permanent": true
    },
    {
      "source": "/docs/greetings",
      "destination": "https://niftyleague.com/docs",
      "permanent": true
    },
    {
      "source": "/greetings",
      "destination": "https://niftyleague.com/docs",
      "permanent": true
    },
    {
      "source": "/docs/tutorial",
      "destination": "https://niftyleague.com/docs",
      "permanent": true
    },
    {
      "source": "/docs/tutorial/:path*",
      "destination": "https://niftyleague.com/docs",
      "permanent": true
    },
    {
      "source": "/tutorial/:path*",
      "destination": "https://niftyleague.com/docs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/"
    },
    {
      "source": "/docs/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/docs/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/docs/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/docs/video/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/docs/favicon/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/video/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
