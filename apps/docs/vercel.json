{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "codex/*": false,
      "**": false,
      "feat/docs-astro-starlight": true,
      "main": true
    }
  },
  "installCommand": "bunx bun@1.4.0 install --frozen-lockfile",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs",
  "rewrites": [
    { "source": "/docs", "destination": "/" },
    { "source": "/docs/:path*", "destination": "/:path*" }
  ]
}
