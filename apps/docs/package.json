{
  "name": "docs",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .turbo && rm -rf .astro",
    "dev": "astro dev --port 3002",
    "format": "oxfmt .",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "preview": "astro preview --port 3002",
    "start": "astro dev --port 3002",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/starlight": "0.42.0",
    "@docsearch/css": "^5.1.0",
    "@docsearch/js": "^5.1.0",
    "@nl/ui": "workspace:*",
    "astro": "7.3.2",
    "mermaid": "^12.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@nl/astro-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "~6.0.3"
  }
}
