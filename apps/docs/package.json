{
  "name": "docs",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && bun scripts/static-files.mjs",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .turbo && rm -rf .astro",
    "dev": "astro dev --port 3002",
    "format": "oxfmt .",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "preview": "astro preview --port 3002",
    "start": "astro dev --port 3002",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "astro sync && bun check && astro check",
    "build:cloudflare": "cd ../.. && bunx turbo run cf:build --filter=docs",
    "cf:build": "bun run build",
    "deploy": "bun run build:cloudflare && cf-wrangler build && cf deploy --prebuilt"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/solid-js": "^7.1.6",
    "@astrojs/starlight": "^0.43.1",
    "@docsearch/css": "^5.2.0",
    "@docsearch/js": "^5.2.0",
    "@nl/ui": "workspace:*",
    "astro": "^7.4.13",
    "mermaid": "^12.3.0",
    "sharp": "^0.35.5",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@nl/astro-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-rc.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.167.0"
  },
  "packageManager": "bun@1.4.4"
}
