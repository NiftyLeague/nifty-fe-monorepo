---
/**
 * Google Tag Manager, deferred.
 *
 * The previous site mounted the shared `DeferredGoogleTagManager` React boundary,
 * which waited for browser idle time before loading GTM and rendered a `<noscript>`
 * fallback iframe. This reproduces that behaviour without pulling React into every
 * page, and installs the container through the shared loader so the script id,
 * URL, and data-layer start push have one definition.
 */
import { GOOGLE_TAG_MANAGER_ID } from '@nl/ui/gtm/constants';
import { productionTelemetryEnabled } from '@nl/ui/gtm/telemetry-gate';

// The shared analytics gate (#1903): GTM is production-only, with an explicit
// opt-out. Before this gate the container loaded on every build, so preview
// deployments and local builds were writing into the production dashboards.
const environment = import.meta.env.PUBLIC_DEPLOY_ENV ?? import.meta.env.VERCEL_ENV ?? 'development';
const telemetryEnabled = productionTelemetryEnabled(
  environment === 'production',
  import.meta.env.PUBLIC_TELEMETRY
);
---

{telemetryEnabled && (
<noscript>
	<iframe
		src={`https://www.googletagmanager.com/ns.html?id=${GOOGLE_TAG_MANAGER_ID}`}
		height="0"
		width="0"
		style="display:none;visibility:hidden"
		title="Google Tag Manager"
	></iframe>
</noscript>
)}

{telemetryEnabled && (
<script>
	import { loadGoogleTagManager } from '@nl/ui/gtm/load';

	// Docs-specific: the load event is already the deferred point here, so the
	// idle callback only needs a short ceiling rather than the shared 5s delay.
	const IDLE_TIMEOUT_MS = 1500;

	const schedule = (callback: () => void) => {
		if ('requestIdleCallback' in window) {
			window.requestIdleCallback(callback, { timeout: IDLE_TIMEOUT_MS });
			return;
		}
		// Older browsers have no idle callback; defer a tick instead.
		globalThis.setTimeout(callback, 1);
	};

	if (document.readyState === 'complete') schedule(loadGoogleTagManager);
	else window.addEventListener('load', () => schedule(loadGoogleTagManager), { once: true });
</script>
)}
