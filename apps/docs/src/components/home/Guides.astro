---
// Guide, developer and quick link columns plus the themed mascot image, ported
// from the previous HomepageGuides component.
import { GITHUB_LINKS, GUIDE_LINKS, QUICK_LINKS } from '../../lib/links';
import ArrowUpRight from '../icons/ArrowUpRight.astro';
import Github from '../icons/Github.astro';
import ThemedImage from '../ThemedImage.astro';
---

<section class="section">
	<div class="row row-two">
		<div>
			<h2>Getting Started</h2>
			<p>
				Explore these docs to learn about our platform and find guides to start playing our games:
			</p>
			{
				GUIDE_LINKS.map(({ title, text, to }) => (
					<a class="card-link" href={to}>
						<div class="card guide-card">
							<div class="link-row">
								<h3 class="card-title">{title}</h3>
								<ArrowUpRight />
							</div>
							<p>{text}</p>
						</div>
					</a>
				))
			}
		</div>
		<div>
			<h2>Developer Links</h2>
			<p>
				Our codebase is comprised of both open-source and proprietary software. View our public code
				below:
			</p>
			{
				GITHUB_LINKS.map(({ title, to }) => (
					<a class="card-link" href={to} target="_blank" rel="noopener noreferrer">
						<div class="card github-card">
							<div class="link-row">
								<span class="styled-icon">
									<Github />
									<h3 class="card-title">{title}</h3>
								</span>
								<ArrowUpRight />
							</div>
						</div>
					</a>
				))
			}
		</div>
		<ThemedImage
			class="themed-mascot"
			sources={{
				light: '/docs/img/misc/frog_400.webp',
				dark: '/docs/img/misc/smash_400.webp',
			}}
			dimensions={{
				light: { width: 1156, height: 600 },
				dark: { width: 1156, height: 600 },
			}}
		/>
		<div>
			<h2>Quick Links</h2>
			{
				QUICK_LINKS.map(({ title, to }) => (
					<a class="quick-link" href={to}>
						<h3 class="card-title">{title}</h3>
						<ArrowUpRight />
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.guide-card {
		margin-bottom: 1rem;
	}

	.github-card {
		margin-bottom: 0.94rem;
	}

	.link-row {
		width: 100%;
		align-items: center;
		justify-content: space-between;
		display: flex;
		flex-direction: row;
	}

	.card h3 {
		margin-bottom: 0;
	}

	.card .link-row p {
		margin-bottom: 0;
	}

	.styled-icon {
		display: flex;
		align-items: center;
	}

	.styled-icon :global(svg) {
		fill: var(--sl-color-white);
	}

	.styled-icon h3 {
		margin-bottom: 0;
		margin-left: 16px;
	}

	.themed-mascot {
		position: relative;
		z-index: -1;
		width: 100%;
		max-height: 400px;
		margin-top: auto;
	}

	.themed-mascot :global(img) {
		width: 100%;
		max-height: 400px;
		object-fit: cover;
	}

	.quick-link {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.5rem;
		padding: 0.4rem 0.6rem;
		margin-inline: -0.6rem;
		border-radius: 0.4rem;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	/* Hover feedback: a highlight band around the row and the arrow picks up
	   the accent. Negative inline margins keep the text alignment unchanged. */
	.quick-link:hover {
		background-color: var(--nl-emphasis-200);
	}

	.quick-link:hover :global(svg) {
		stroke: var(--sl-color-accent);
	}

	.quick-link h3 {
		margin-bottom: 0;
	}
</style>
