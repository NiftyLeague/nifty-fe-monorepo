---
// Replaces Starlight's header to reproduce the previous navbar: section links
// next to the site title and, on the trailing edge, the external links, theme
// toggle and search button. Starlight's default header has no slots, so the
// markup is rebuilt here from the same building blocks.
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import config from 'virtual:starlight/user-config';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

// The previous site's persistent navbar links.
const NAV_LINKS = [
	{ label: 'Overview', href: '/docs/overview/intro' },
	{ label: 'Guides', href: '/docs/guides/set-up' },
	{ label: 'FAQ', href: '/docs/faq/general' },
];

const EXTERNAL_LINKS = [
	{ label: 'Website', href: 'https://niftyleague.com/' },
	{ label: 'GitHub', href: 'https://github.com/NiftyLeague/docs' },
	{ label: 'Discord', href: 'https://discord.gg/niftyleague' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
		<nav class="nav-links" aria-label="Documentation sections">
			{
				NAV_LINKS.map(({ label, href }) => (
					<a href={href} aria-current={currentPath === href ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="right-group sl-flex print:hidden">
		<nav class="external-links" aria-label="Nifty League">
			{
				EXTERNAL_LINKS.map(({ label, href }) => (
					<a href={href} target="_blank" rel="noopener noreferrer">
						{label}
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							aria-hidden="true"
						>
							<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
							<path d="M15 3h6v6" />
							<path d="M10 14 21 3" />
						</svg>
						<span class="sr-only">(opens in new tab)</span>
					</a>
				))
			}
		</nav>
		<ThemeSelect />
		{shouldRenderSearch && <Search />}
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			gap: 1.5rem;
			align-items: center;
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 0.25rem;
		}

		.nav-links a {
			display: inline-block;
			padding: 0.25rem 1rem;
			font-size: var(--sl-text-body);
			font-weight: 500;
			color: var(--sl-color-white);
			text-decoration: none;
			white-space: nowrap;
		}

		.nav-links a:hover,
		.nav-links a[aria-current='page'] {
			color: var(--sl-color-accent);
		}

		.right-group {
			gap: 1.5rem;
			align-items: center;
		}

		.external-links {
			display: flex;
			align-items: center;
			gap: 1.5rem;
		}

		.external-links a {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
			font-size: var(--sl-text-body);
			font-weight: 500;
			color: var(--sl-color-white);
			text-decoration: none;
			white-space: nowrap;
		}

		.external-links a:hover {
			color: var(--sl-color-accent);
		}

		.external-links svg {
			width: 0.75em;
			height: 0.75em;
		}

		/* The previous navbar thinned in two steps rather than dropping everything
		    at once: the trailing external links went first (1280px), then the
		    section links and the theme toggle (996px). Matching those queries keeps
		    the same links visible at the same widths. */
		@media (max-width: 1280px) {
			.external-links {
				display: none;
			}
		}

		@media (max-width: 996px) {
			.nav-links {
				display: none;
			}

			:global(starlight-theme-toggle) {
				display: none;
			}
		}
	}
</style>
