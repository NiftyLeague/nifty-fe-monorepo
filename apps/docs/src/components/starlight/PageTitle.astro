---
/**
 * Renders the breadcrumb trail and page heading.
 *
 * `hideTitle` is set on the few pages that carry a leading `<h1>` in their body
 * (the previous site rendered that heading instead of the frontmatter title),
 * and on the landing page, which renders its heading inside the hero. The
 * breadcrumbs still render on those pages.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Breadcrumbs from './Breadcrumbs.astro';

const { entry, id } = Astro.locals.starlightRoute;
const isHome = id === '' || id === 'index';
---

{!isHome && <Breadcrumbs />}
{!entry.data.hideTitle && !isHome && <Default />}
