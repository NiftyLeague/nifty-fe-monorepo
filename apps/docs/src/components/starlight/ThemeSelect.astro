---
// The previous site switched theme from a small moon/sun icon button rather than
// a three-option select. This keeps Starlight's storage and system-preference
// behaviour while swapping the control.
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-toggle>
	<button type="button" class="theme-toggle" aria-label="Toggle dark mode">
		<span class="sl-hidden dark:sl-block"><Icon name="moon" /></span>
		<span class="sl-block dark:sl-hidden"><Icon name="sun" /></span>
	</button>
</starlight-theme-toggle>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro`. */}
<script is:inline>
	window.StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';
	const storageKey = 'starlight-theme';

	const loadTheme = (): Theme => {
		const stored = typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
		return stored === 'light' || stored === 'dark' ? stored : 'auto';
	};
	const storeTheme = (theme: Theme) => {
		if (typeof localStorage === 'undefined') return;
		localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
	};
	const getPreferredColorScheme = (): 'dark' | 'light' =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function applyTheme(theme: Theme): void {
		document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
		storeTheme(theme);
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') applyTheme('auto');
	});

	class StarlightThemeToggle extends HTMLElement {
		constructor() {
			super();
			this.querySelector('button')?.addEventListener('click', () => {
				const current = document.documentElement.dataset.theme;
				applyTheme(current === 'dark' ? 'light' : 'dark');
			});
		}
	}
	if (!customElements.get('starlight-theme-toggle'))
		customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>

<style>
	@layer starlight.core {
		.theme-toggle {
			display: flex;
			align-items: center;
			border: 0;
			background: transparent;
			color: var(--sl-color-gray-2);
			cursor: pointer;
			padding: 0;
		}

		.theme-toggle:hover {
			color: var(--sl-color-white);
		}

		.theme-toggle svg {
			width: 1.4rem;
			height: 1.4rem;
		}
	}
</style>
