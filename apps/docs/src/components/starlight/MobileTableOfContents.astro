---
/**
 * Mobile "On this page" disclosure.
 *
 * Starlight always emits a TOC entry for the page title, so `toc` is truthy even
 * on pages that have no headings. The previous site showed no control (and
 * reserved no space) in that case, so this renders the disclosure only when the
 * page actually has headings. Markup mirrors Starlight's component; the list is
 * rendered here because the internal list component is not a public export.
 */
import { Icon } from '@astrojs/starlight/components';

const { toc } = Astro.locals.starlightRoute;

interface TocItem {
	text: string;
	slug: string;
	depth: number;
	children: TocItem[];
}

/** Flatten the nested TOC tree, dropping the page-title entry (it links to `_top`). */
function flatten(items: TocItem[], depth = 0): Array<{ text: string; href: string; depth: number }> {
	return items.flatMap((item) => [
		...(item.slug === '_top' ? [] : [{ text: item.text, href: `#${item.slug}`, depth }]),
		...flatten(item.children ?? [], depth + 1),
	]);
}

const headings = flatten((toc?.items ?? []) as TocItem[]);
---

{
	toc && headings.length > 0 && (
		<mobile-starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
			<nav aria-labelledby="starlight__on-this-page--mobile">
				<details id="starlight__mobile-toc">
					<summary id="starlight__on-this-page--mobile" class="sl-flex">
						<span class="toggle sl-flex">
							{Astro.locals.t('tableOfContents.onThisPage')}
							<Icon name={'right-caret'} class="caret" size="1rem" />
						</span>
						<span class="display-current" />
					</summary>
					<div class="dropdown">
						<ul class="isMobile">
							{headings.map((heading) => (
								<li style={`--depth: ${heading.depth};`}>
									<a href={heading.href} style={`--depth: ${heading.depth};`}>
										<span set:html={heading.text} />
									</a>
								</li>
							))}
						</ul>
					</div>
				</details>
			</nav>
		</mobile-starlight-toc>
	)
}

<style>
	@layer starlight.core {
		ul {
			list-style: none;
			margin: 0;
			padding: 0.5rem 1rem 1rem;
		}

		li + li {
			margin-top: 0.25rem;
		}

		li {
			padding-inline-start: calc(var(--depth, 0) * 0.75rem);
		}

		a {
			display: block;
			color: var(--sl-color-gray-2);
			text-decoration: none;
			font-size: var(--sl-text-sm);
		}

		a:hover {
			color: var(--sl-color-white);
		}
	}
</style>
