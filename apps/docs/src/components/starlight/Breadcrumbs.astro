---
/**
 * Breadcrumb trail, matching the previous site: a home icon followed by the
 * sidebar groups that contain the current page, ending with the page title.
 *
 * Starlight has no breadcrumb component, so the group path is derived from the
 * (section-scoped) sidebar tree. The previous site always ended the trail with
 * the current page, including on top-level pages that have no groups.
 */
import { sectionEntries, sectionForId, type SidebarEntry } from '../../lib/navigation';

const { entry, sidebar } = Astro.locals.starlightRoute;
const isHome = entry.id === '' || entry.id === 'index';

/** Labels of the groups that contain `href`, outermost first. */
function groupTrail(entries: SidebarEntry[], href: string): string[] | undefined {
  for (const item of entries) {
    if (item.type === 'link') {
      if (item.href.replace(/\/$/, '') === href.replace(/\/$/, '')) return [];
      continue;
    }
    const nested = groupTrail(item.entries, href);
    if (nested) return [item.label, ...nested];
  }
  return undefined;
}

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const groups = groupTrail(sectionEntries(sidebar, sectionForId(entry.id)), currentPath);
const trail = groups ? [...groups, entry.data.title] : undefined;
---

{
	trail && !isHome && (
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<ol>
					<li>
						<a href="/docs" aria-label="Home">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									fill="currentColor"
									d="M10 19v-5h4v5c0 .55.45 1 1 1h3c.55 0 1-.45 1-1v-7h1.7c.46 0 .68-.57.33-.87L12.67 3.6c-.38-.34-.96-.34-1.34 0l-8.36 7.53c-.34.3-.13.87.33.87H5v7c0 .55.45 1 1 1h3c.55 0 1-.45 1-1z"
								/>
							</svg>
						</a>
					</li>
				{trail.map((label, index) => (
					<li>
						<span aria-current={index === trail.length - 1 ? 'page' : undefined}>{label}</span>
					</li>
				))}
			</ol>
		</nav>
	)
}
