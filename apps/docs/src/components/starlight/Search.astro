---
/**
 * Algolia DocSearch, loaded on demand.
 *
 * DocSearch is the largest script on the site and is only useful once the visitor
 * asks for it, so the module is imported on the first interaction (click or
 * Cmd/Ctrl+K) instead of on page load. Content pages therefore ship no search
 * bundle at all.
 *
 * The trigger is the site's own button rather than DocSearch's, so the modal is
 * opened by calling `open()` on the instance: one click opens search, instead of
 * needing a second click on the button DocSearch would otherwise render.
 */
import { Icon } from '@astrojs/starlight/components';

const label = Astro.locals.t('search.label');
const ctrlKey = Astro.locals.t('search.ctrlKey');
---

<site-search>
	{/* The accessible name spells out the visible label and shortcut so it always
	    contains the text on screen (WCAG 2.5.3); the inline script below rewrites
	    both together when it switches the hint to the platform's modifier key. */}
	<button
		data-open-modal
		disabled
		aria-label={`${label} (${ctrlKey}+K)`}
		aria-keyshortcuts="Control+K"
	>
		<Icon name="magnifier" />
		<span class="sl-hidden md:sl-block" aria-hidden="true">{label}</span>
		<kbd class="sl-hidden md:sl-flex" style="display: none;" aria-hidden="true">
			<kbd>{ctrlKey}</kbd><kbd>K</kbd>
		</kbd>
	</button>

	{/* DocSearch mounts into an off-screen container; its own trigger is hidden
	    because the button above drives the modal. */}
	<div id="starlight__search" hidden></div>
</site-search>

<script is:inline>
	(() => {
		const openBtn = document.querySelector('button[data-open-modal]');
		const shortcut = openBtn?.querySelector('kbd');
		if (!openBtn || !(shortcut instanceof HTMLElement)) return;
		const platformKey = shortcut.querySelector('kbd');
		const isApple = /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform);
		if (platformKey && isApple) {
			platformKey.textContent = '⌘';
			openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
			// Keep the accessible name in step with the visible shortcut.
			const label = openBtn.getAttribute('aria-label')?.split(' (')[0];
			if (label) openBtn.setAttribute('aria-label', `${label} (⌘+K)`);
		}
		shortcut.style.display = '';
	})();
</script>

<script>
	import type { DocSearchInstance } from '@docsearch/js/docsearch';

	let docSearchPromise: Promise<DocSearchInstance | undefined> | undefined;

	/** Imports DocSearch once and mounts it into the container. */
	function loadDocSearch(container: HTMLElement): Promise<DocSearchInstance | undefined> {
		docSearchPromise ??= import('@docsearch/js/docsearch')
			.then(({ default: docsearch }) =>
				docsearch({
					container,
					appId: import.meta.env.PUBLIC_ALGOLIA_APP_ID ?? 'QHFGNYFTED',
					apiKey: import.meta.env.PUBLIC_ALGOLIA_API_KEY ?? 'a279745db091a62dd51ec3212d11a5d0',
					indices: ['docs'],
				})
			)
			.catch(() => {
				/* search is an enhancement: a failed load must not break the page */
				return undefined;
			});
		return docSearchPromise;
	}

	class SiteSearch extends HTMLElement {
		constructor() {
			super();
			const openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]')!;
			const container = this.querySelector<HTMLElement>('#starlight__search')!;

			const openModal = async () => {
				const instance = await loadDocSearch(container);
				instance?.open();
			};

			openBtn.addEventListener('click', (event) => {
				event.stopPropagation();
				void openModal();
			});
			openBtn.disabled = false;

			// Ctrl/Cmd+K opens search, matching the previous navbar shortcut.
			window.addEventListener('keydown', (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
					event.preventDefault();
					void openModal();
				}
			});
		}
	}

	if (!customElements.get('site-search')) customElements.define('site-search', SiteSearch);
</script>

<style>
	@layer starlight.core {
		/* DocSearch renders its trigger button into the container; the site button
		   above replaces it, so keep the mount point out of the layout. */
		#starlight__search[hidden] {
			display: none;
		}
	}
</style>
