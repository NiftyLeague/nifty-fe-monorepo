---
import Auth from '@/layouts/Auth.astro'
import LoginClient from '@/components/login/LoginClient'
import { getSession } from '@/utils/session'

const session = await getSession(Astro)

// Redirect to profile if already logged in.
if (session.user?.isLoggedIn) return Astro.redirect('/profile', 302)

// Pass only the serializable fields; the iron-session handle itself cannot
// cross into the island payload.
const sessionData = { user: session.user ?? null }
---
<Auth canonical="/login" metadata={{ title: 'Login', noindex: true }}>
  {/* Server-rendered (M5.6 audit #1883): the form painted nothing contentful
      until the client:only island hydrated (~4 s on the Lighthouse mobile
      profile), and the skeleton fallback never counted as a contentful paint.
      The island is SSR-safe — first render is the deterministic logged-out
      state, and the browser-only reads sit in effects and event handlers. */}
  <LoginClient client:load sessionData={sessionData} />
</Auth>
