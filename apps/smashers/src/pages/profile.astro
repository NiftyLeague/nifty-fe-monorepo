---
import Auth from '@/layouts/Auth.astro'
import ProfileClient from '@/components/profile/ProfileClient'
import { getSession } from '@/utils/session'

const session = await getSession(Astro)

// Redirect to login if not authorized.
if (!session.user?.isLoggedIn) return Astro.redirect('/login', 302)

const sessionData = { user: session.user }
---
<Auth canonical="/profile" metadata={{ title: 'Profile', noindex: true }}>
  <ProfileClient client:load sessionData={sessionData} />
</Auth>
