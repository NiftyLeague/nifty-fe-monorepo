---
import Base from './Base.astro'
import type { RouteMetadata } from '../runtime/metadata'

interface Props {
  metadata?: RouteMetadata
  canonical?: string
}
const { metadata = { title: 'Profile', noindex: true }, canonical } = Astro.props
---
<Base metadata={metadata} canonical={canonical}>
  {/*
    No provider island here. Astro gives every `client:*` element its own React
    root, so wrapping the slot in `AuthProviders` could not pass context to the
    page's island: the profile account panel rendered empty and the login form
    saw no feature flags. Each page island now renders the providers itself, and
    this stays a plain shell.
  */}
  <main id="auth-layout" class="min-h-screen">
    <slot />
  </main>
</Base>
