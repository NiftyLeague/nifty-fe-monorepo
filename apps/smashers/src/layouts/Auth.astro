---
import Base from './Base.astro'
import AuthProviders from '@/contexts/AuthProviders'
import type { RouteMetadata } from '../runtime/metadata'

interface Props {
  metadata?: RouteMetadata
  canonical?: string
}
const { metadata = { title: 'Profile', noindex: true }, canonical } = Astro.props
---
<Base metadata={metadata} canonical={canonical}>
  <AuthProviders client:only="react">
    <main id="auth-layout" class="min-h-screen">
      <slot />
    </main>
  </AuthProviders>
</Base>
