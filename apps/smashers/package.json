{
  "name": "smashers",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .astro && rm -rf dist",
    "dev": "astro dev --port 3003",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test --conditions=browser --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --conditions=browser --isolate --preload ../../test/solid-jsx.ts --preload --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:e2e": "bunx playwright test",
    "test:watch": "bun test --watch",
    "type-check": "astro sync && bun check && astro check",
    "build:cloudflare": "cd ../.. && bunx turbo run cf:build --filter=smashers",
    "cf:build": "bun scripts/build-cloudflare.mjs && bun scripts/sync-client-assets.mjs",
    "deploy": "bun run build:cloudflare && cf-wrangler build && cf deploy --prebuilt"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/solid-js": "^7.1.6",
    "@nl/playfab": "workspace:*",
    "@nl/ui": "workspace:*",
    "@sentry/browser": "^11.17.0",
    "@sentry/node": "^11.17.0",
    "astro": "^7.4.13",
    "iron-session": "^9.1.1",
    "lucide-solid": "^1.78.0",
    "solid-js": "^1.9.20",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@nl/astro-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "cf": "^1.0.0-rc.4",
    "wrangler": "^4.167.0"
  },
  "packageManager": "bun@1.4.4"
}
