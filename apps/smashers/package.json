{
  "name": "smashers",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .astro && rm -rf dist",
    "dev": "astro dev --port 3003",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test --conditions=browser --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --conditions=browser --isolate --preload ../../test/solid-jsx.ts --preload --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:e2e": "bunx playwright test",
    "test:watch": "bun test --watch",
    "type-check": "astro check",
    "build:cloudflare": "bun scripts/build-cloudflare.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/solid-js": "^7.0.2",
    "@nl/playfab": "workspace:*",
    "@nl/ui": "workspace:*",
    "@sentry/browser": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "astro": "^7.3.2",
    "iron-session": "^9.0.1",
    "lucide-solid": "^1.46.0",
    "solid-js": "^1.9.15",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.1",
    "@nl/astro-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1"
  }
}
