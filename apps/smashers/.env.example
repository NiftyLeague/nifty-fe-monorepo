# smashers runs on Astro SSR. Public values use the PUBLIC_* convention; the
# legacy NEXT_PUBLIC_* names are still read as a fallback so an existing
# deployment keeps working through the cutover.
PUBLIC_SITE_URL=http://localhost:3003

PUBLIC_PLAYFAB_TITLE_ID=your-title-ID
PLAYFAB_API_KEY=your-secret-key

PUBLIC_APPLE_STORE_ID=your-app-name/your-store-id
PUBLIC_APPLE_STORE_LINK=your-link
PUBLIC_EPIC_LINK=your-link
PUBLIC_GOOGLE_PLAY_LINK=your-link
PUBLIC_STEAM_LINK=your-link

# run $ openssl rand -base64 32
SESSION_SECRET=your-generated-secret

# OAuth providers linked to PlayFab accounts. Register each redirect URI with
# the provider: https://niftysmashers.com/api/auth/callback/<provider>
# Apple's "client secret" is a pre-generated ES256 JWT, not a static string.
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

APPLE_CLIENT_ID=your-client-id
APPLE_CLIENT_SECRET=your-client-secret

FACEBOOK_CLIENT_ID=your-client-id
FACEBOOK_CLIENT_SECRET=your-client-secret

TWITCH_CLIENT_ID=your-client-id
TWITCH_CLIENT_SECRET=your-client-secret

PUBLIC_UNITY_SMASHERS_BASE_VERSION=current-smasherss-version
PUBLIC_UNITY_SMASHERS_BASE_URL=smashers-base-url
PUBLIC_UNITY_USE_COMPRESSED=true

PUBLIC_SUBGRAPH_VERSION=version-or-undefined

PUBLIC_DEPLOY_ENV=development
PUBLIC_TELEMETRY=true
PUBLIC_FEATURE_FLAGS='{"enableFeature":false, ...}'
PUBLIC_AUTH_PROVIDERS='google,apple,facebook,twitch,...'
