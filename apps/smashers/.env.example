# smashers runs on Astro SSR.
#
# Naming: the code accepts both PUBLIC_* (the convention the Astro apps use) and
# the legacy NEXT_PUBLIC_* names. The live Vercel project still holds the
# NEXT_PUBLIC_* spellings and they are honoured, so a cutover does not require
# renaming variables in lockstep with the deploy. Rename at your leisure — both
# spellings resolve identically — and delete whichever set you stop using.
#
# Anything client-side (the NEXT_PUBLIC_* entries below) is inlined at build time
# by the `define` block in astro.config.mjs and needs a rebuild to change.
# Server-side values (session secret, OAuth secrets, store links) are read from
# process.env at request time, so they need no rebuild.

# --- client (inlined at build time) ---
PUBLIC_SITE_URL=http://localhost:3003

PUBLIC_PLAYFAB_TITLE_ID=your-title-ID
PUBLIC_APPLE_STORE_ID=your-app-name/your-store-id
PUBLIC_APPLE_STORE_LINK=your-link
PUBLIC_EPIC_LINK=your-link
PUBLIC_GOOGLE_PLAY_LINK=your-link
PUBLIC_STEAM_LINK=your-link

PUBLIC_DEPLOY_ENV=development
PUBLIC_TELEMETRY=true
PUBLIC_FEATURE_FLAGS='{"enableFeature":false, ...}'
PUBLIC_AUTH_PROVIDERS='google,apple,facebook,twitch,...'

# --- server only (read per request; never inlined into the client) ---
PLAYFAB_API_KEY=your-secret-key

# Session cookie seal and OAuth flow seal.
#
# SESSION_SECRET is optional: the app falls back to NEXTAUTH_SECRET, which is
# deliberate on the live project. Reusing the existing secret means the
# `iron_session_playfab` cookies already issued by the previous Next.js build
# keep validating after cutover, so nobody is signed out by the migration.
# Introducing a *new* secret here would invalidate every live session.
# run $ openssl rand -base64 32
SESSION_SECRET=

# OAuth providers linked to PlayFab accounts. Register each redirect URI with the
# provider: https://niftysmashers.com/api/auth/callback/<provider>
# Apple's "client secret" is a pre-generated ES256 JWT, not a static string.
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

APPLE_CLIENT_ID=your-client-id
APPLE_CLIENT_SECRET=your-client-secret

FACEBOOK_CLIENT_ID=your-client-id
FACEBOOK_CLIENT_SECRET=your-client-secret

TWITCH_CLIENT_ID=your-client-id
TWITCH_CLIENT_SECRET=your-client-secret

# Server-side error reporting (production only; lazily imported).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=niftyleague
SENTRY_PROJECT=nifty-smashers-web
