{
  "name": "app",
  "version": "1.1.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NEXT_TYPESCRIPT_NO_AUTO_INSTALL=1 next build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .next",
    "dev": "next dev --webpack --port 3001",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,mdx,json}\" --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "start": "next start",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@axelar-network/axelarjs-sdk": "^0.21.0",
    "@cowprotocol/cow-sdk": "^9.2.6",
    "@hookform/resolvers": "^5.6.0",
    "@nl/imx-passport": "workspace:*",
    "@nl/sentry-client": "workspace:*",
    "@nl/ui": "workspace:*",
    "@openzeppelin/contracts": "^5.6.1",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "bnc-notify": "^1.9.8",
    "bnc-sdk": "^4.6.9",
    "eth-rpc-errors": "^4.0.3",
    "ethers": "^6.17.0",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "lodash": "^4.18.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-number-format": "^5.4.5",
    "react-slick": "^0.31.0",
    "react-unity-webgl": "~10.2.0",
    "save-as": "^0.1.8",
    "set-interval-async": "^3.0.3",
    "sharp": "^0.35.3",
    "slick-carousel": "~1.8.1",
    "sonner": "^2.0.7",
    "viem": "^2.55.10",
    "wagmi": "^3.7.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-slick": "^0.23.13"
  }
}
