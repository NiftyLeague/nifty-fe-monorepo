{
  "name": "app",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/prepare-images.mjs && vite build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .output && rm -rf .vite && rm -rf .app-images",
    "dev": "bun scripts/prepare-images.mjs && vite dev",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "vite preview",
    "test": "bun test --isolate --conditions=browser --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --conditions=browser --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "bun check",
    "build:cloudflare": "cd ../.. && bunx turbo run cf:build --filter=app",
    "cf:build": "bun scripts/prepare-images.mjs && vite build && bun scripts/post-build-worker.mjs",
    "deploy": "bun run build:cloudflare && cf-wrangler build && cf deploy --prebuilt"
  },
  "dependencies": {
    "@nl/contracts": "workspace:*",
    "@nl/ui": "workspace:*",
    "@reown/appkit": "^2.0.0",
    "@reown/appkit-adapter-wagmi": "^2.0.0",
    "@sentry/browser": "^11.17.0",
    "@tanstack/solid-query": "5.108.4",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-router-ssr-query": "^1.167.3",
    "@tanstack/solid-start": "^1.169.7",
    "@wagmi/core": "^3.6.9",
    "lucide-solid": "^1.78.0",
    "solid-js": "^1.9.20",
    "solid-sonner": "^0.3.2",
    "viem": "^2.55.19",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "cf": "^1.0.0-rc.4",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "nitro": "^3.0.261103-rc",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "wrangler": "^4.167.0"
  },
  "packageManager": "bun@1.4.4"
}
