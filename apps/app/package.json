{
  "name": "app",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/prepare-images.mjs && vite build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .output && rm -rf .vite && rm -rf .vercel && rm -rf .app-images",
    "dev": "bun scripts/prepare-images.mjs && vite dev",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "vite preview",
    "test": "bun test --isolate --conditions=browser --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --conditions=browser --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modular-forms/solid": "^0.25.1",
    "@nl/contracts": "workspace:*",
    "@nl/imx-passport": "workspace:*",
    "@nl/ui": "workspace:*",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@sentry/browser": "^10.69.0",
    "@tanstack/solid-query": "5.102.8",
    "@tanstack/solid-router": "1.170.34",
    "@tanstack/solid-router-ssr-query": "^1.167.2",
    "@tanstack/solid-start": "1.168.52",
    "@wagmi/core": "3.6.5",
    "bnc-notify": "^1.9.8",
    "bnc-sdk": "^4.6.9",
    "eth-rpc-errors": "^4.0.3",
    "ethers": "^6.17.0",
    "lucide-solid": "^1.46.0",
    "nuqs": "^2.10.1",
    "set-interval-async": "^3.0.3",
    "solid-js": "^1.9.15",
    "solid-sonner": "^0.3.2",
    "viem": "^2.55.19",
    "web-vitals": "^6.2.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "nitro": "^3.0.260903-beta",
    "sharp": "^0.35.4",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.12"
  }
}
