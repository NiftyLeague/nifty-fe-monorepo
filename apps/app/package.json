{
  "name": "app",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .output && rm -rf .vite",
    "dev": "vite dev",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "vite preview",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nl/contracts": "workspace:*",
    "@nl/imx-passport": "workspace:*",
    "@nl/ui": "workspace:*",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@sentry/browser": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.52",
    "bnc-notify": "^1.9.8",
    "bnc-sdk": "^4.6.9",
    "eth-rpc-errors": "^4.0.3",
    "ethers": "^6.17.0",
    "lucide-react": "^1.31.0",
    "nuqs": "^2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "react-number-format": "^5.4.5",
    "react-unity-webgl": "~10.2.0",
    "save-as": "^0.1.8",
    "set-interval-async": "^3.0.3",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "viem": "^2.55.19",
    "wagmi": "^3.7.5",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "^3.0.260903-beta",
    "vite": "^8.3.0"
  }
