{
  "name": "app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/prepare-images.mjs && vite build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .output && rm -rf .vite && rm -rf .app-images",
    "dev": "bun scripts/prepare-images.mjs && vite dev",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "vite preview",
    "test": "bun test --isolate --conditions=browser --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --conditions=browser --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit",
    "build:cloudflare": "cd ../.. && bunx turbo run cf:build --filter=app && bun scripts/restore-cached-media.mjs app",
    "cf:build": "bun scripts/prepare-images.mjs && vite build && bun scripts/post-build-worker.mjs"
  },
  "dependencies": {
    "@nl/contracts": "workspace:*",
    "@nl/ui": "workspace:*",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@sentry/browser": "^10.69.0",
    "@tanstack/solid-query": "^5.102.8",
    "@tanstack/solid-router": "^1.170.34",
    "@tanstack/solid-router-ssr-query": "^1.167.2",
    "@tanstack/solid-start": "^1.168.52",
    "@wagmi/core": "^3.6.5",
    "lucide-solid": "^1.46.0",
    "solid-js": "^1.9.15",
    "solid-sonner": "^0.3.2",
    "viem": "^2.55.19",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "nitro": "^3.0.260903-beta",
    "sharp": "^0.35.4",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.12"
  }
}
