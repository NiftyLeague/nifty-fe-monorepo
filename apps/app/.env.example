# ===========================|| WalletConnect ||==========================

VITE_NETWORK=mainnet # mainnet | sepolia | hardhat

VITE_WALLET_CONNECT_PROJECT_ID=xxxxx

VITE_ETHERSCAN_KEY=xxxxx

VITE_INFURA_PROJECT_ID=xxxxx

VITE_ALCHEMY_SEPOLIA_API=xxxxx
VITE_ALCHEMY_MAINNET_API=xxxxx

# ==============================|| Notify ||==============================

VITE_BLOCKNATIVE_DAPPID=xxxxx

# =============================|| Subgraph ||=============================

VITE_GRAPH_API_KEY=xxxxx
VITE_GRAPH_ID=xxxxx

# ===============================|| IMX ||================================

VITE_SANDBOX_LINK_URL=https://link.x.immutable.com  # testnet: https://link.sandbox.x.immutable.com
VITE_SANDBOX_ENV_URL=https://api.x.immutable.com/v1 # testnet: https://api.sandbox.x.immutable.com/v1

# ===========================|| Feature Flags ||==========================

VITE_FEATURE_FLAGS='{"key1":false,"key2":true}'

# ============================|| Unity WebGL ||===========================

VITE_UNITY_USE_COMPRESSED=false

VITE_UNITY_CREATOR_BASE_URL=https://d7ct17ettlkln.cloudfront.net/nc/prod/1.7.2-2634aece327c
VITE_UNITY_CREATOR_BASE_VERSION='1.7.2'

VITE_UNITY_MOBILE_CREATOR_BASE_URL=https://d7ct17ettlkln.cloudfront.net/nc/prod/m1.6.10-c1cace68c47d
VITE_UNITY_MOBILE_CREATOR_BASE_VERSION='m1.6.10'

VITE_UNITY_SMASHERS_BASE_URL=https://d7ct17ettlkln.cloudfront.net/ns/prod/0.53.1-eb048de3b4a0
VITE_UNITY_SMASHERS_BASE_VERSION='0.53.1'

VITE_UNITY_WEN_BASE_URL=https://d7ct17ettlkln.cloudfront.net/wg/prod/1.0.7-db2ffcb8be96
VITE_UNITY_WEN_BASE_VERSION='1.0.7'

VITE_UNITY_BURNER_BASE_URL=https://d7ct17ettlkln.cloudfront.net/nb/prod/1.0.8-9563cf52addc
VITE_UNITY_BURNER_BASE_VERSION='1.0.8'

VITE_UNITY_CRYPTO_WINTER_BASE_URL=https://d7ct17ettlkln.cloudfront.net/cw/prod/1.0.19-e321c17b263b
VITE_UNITY_CRYPTO_WINTER_BASE_VERSION='1.0.19'

# =============================|| Debugging ||============================

VITE_DEBUG=true

# Explicitly opt in to local visual-audit fixtures; leave false for normal builds.
VITE_AUDIT_FIXTURE=false
