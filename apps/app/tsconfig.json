{
  "extends": "@nl/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@nl/ui/*": [
        "../../packages/ui/src/*"
      ]
    },
    "jsxImportSource": "solid-js"
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/types/typechain/**"
  ]
}
