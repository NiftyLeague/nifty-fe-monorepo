{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .next",
    "dev": "next dev --port 3000",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,mdx,json}\" --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "start": "next start",
    "test": "bun test --project-placeholder web",
    "test:coverage": "VITEST_SCOPE=apps/web bun test --project-placeholder web --coverage",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@nl/ui": "workspace:*",
    "@sentry/nextjs": "^10.65.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-multi-carousel": "^2.8.6",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "viem": "^2.55.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "next-sitemap": "^4.2.3"
  }
}
