{
  "name": "web",
  "version": "1.0.4",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf .next",
    "dev": "next dev --turbopack --port 3000",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,mdx,json}\" --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "start": "next start",
    "test": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@nl/sentry-client": "workspace:*",
    "@nl/ui": "workspace:*",
    "@sentry/nextjs": "^10.69.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "next-sitemap": "^4.2.3"
  }
}
