{
  "name": "web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/prepare-images.mjs && astro build && bun scripts/finalize-static.mjs && bun scripts/check-static.mjs",
    "clean": "rm -rf node_modules .turbo .astro .web-images .worker-build dist",
    "cloudflare:build": "bun run build && wrangler deploy --dry-run --outdir .worker-build",
    "cloudflare:upload": "wrangler versions upload",
    "dev": "bun scripts/prepare-images.mjs && astro dev --port 3000",
    "format": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "performance:compare": "node scripts/compare-deployed.mjs",
    "preview": "bun run build && wrangler dev --local --port 3000",
    "start": "wrangler dev --local --port 3000",
    "test": "bun test --conditions=browser --isolate --preload ../../test/happy-dom-setup.ts --preload ../../test/solid-jsx.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --pass-with-no-tests",
    "test:coverage": "bun test --conditions=browser --isolate --preload ../../test/solid-jsx.ts --preload --preload ../../test/happy-dom-setup.ts --preload ../../test/preload.ts --preload ../../test/setup.ts --coverage --pass-with-no-tests",
    "test:e2e": "bun run build && playwright test",
    "test:routes": "node --test checks/routes.node.mjs",
    "test:watch": "bun test --watch",
    "type-check": "bun scripts/prepare-images.mjs --metadata-only && astro check",
    "build:cloudflare": "cd ../.. && bunx turbo run cf:build --filter=web",
    "cf:build": "bun run build"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@google/model-viewer": "^4.3.1",
    "@nl/ui": "workspace:*",
    "@sentry/browser": "^10.69.0",
    "astro": "^7.3.2",
    "lucide-solid": "^1.46.0",
    "sharp": "^0.35.4",
    "solid-js": "^1.9.15",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.1",
    "@nl/astro-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "wrangler": "^4.130.0"
  }
}
