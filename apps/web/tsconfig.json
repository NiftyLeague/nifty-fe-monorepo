{
  "extends": ["astro/tsconfigs/strict", "@nl/typescript-config/astro.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@nl/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "worker/**/*", "playwright.config.ts", "e2e/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
