---
import Base from './Base.astro'
import Navbar from '@/components/Navbar'
import Footer from '@/components/Footer'
interface Props { metadata?: object; rootClass?: string; canonical?: string }
const { metadata = {}, rootClass = '', canonical = Astro.url.pathname } = Astro.props
---
<Base metadata={metadata} canonical={canonical}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Navbar client:load />
  <main id="main-content" class={rootClass} tabindex="-1"><slot /></main>
  <Footer />
</Base>
