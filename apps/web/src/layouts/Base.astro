---
import '../styles/app.css'
import { DEFAULT_METADATA, metadataValues } from '../runtime/metadata'
import defaultFontUrl from '../../../../packages/ui/src/lib/fonts/assets/ibm-plex-sans-400.woff2?url'
import headerFontUrl from '../../../../packages/ui/src/lib/fonts/NexaRustSans_Black/NexaRustSans-Black.woff2?url'
import specialFontUrl from '../../../../packages/ui/src/lib/fonts/assets/press-start-2p-400.woff2?url'

interface Props {
  metadata?: object
  canonical?: string
  noindex?: boolean
  analytics?: boolean
}
const { metadata = {}, canonical = Astro.url.pathname, noindex = false, analytics = true } = Astro.props
const values = metadataValues(metadata as Record<string, unknown>, canonical)
const fontCss = `
@font-face{font-family:"Web IBM Plex Sans";src:url("${defaultFontUrl}") format("woff2");font-weight:400 700;font-style:normal;font-display:swap}
@font-face{font-family:"Web Nexa Rust";src:url("${headerFontUrl}") format("woff2");font-weight:700;font-style:normal;font-display:swap}
@font-face{font-family:"Web Press Start 2P";src:url("${specialFontUrl}") format("woff2");font-weight:400;font-style:normal;font-display:swap}
:root{--font-ibm-plex-sans:"Web IBM Plex Sans";--font-nexa-rust-sans-black:"Web Nexa Rust";--font-press-start-2p:"Web Press Start 2P"}
astro-island{display:contents}
`
const environment = import.meta.env.PUBLIC_DEPLOY_ENV ?? import.meta.env.VERCEL_ENV ?? 'development'
const telemetryEnabled = import.meta.env.PUBLIC_TELEMETRY !== 'false' && environment === 'production'
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#18181b" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="origin-when-cross-origin" />
    <title>{values.title}</title>
    <meta name="description" content={values.description} />
    <meta name="keywords" content={DEFAULT_METADATA.keywords.join(', ')} />
    <meta name="author" content="0xPlayerOne" />
    <link rel="canonical" href={values.canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={values.ogTitle} />
    <meta property="og:description" content={values.ogDescription} />
    <meta property="og:url" content={values.canonical} />
    <meta property="og:site_name" content="Nifty League" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    {values.images.map((image) => <meta property="og:image" content={image} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={values.title} />
    <meta name="twitter:description" content={values.description} />
    <meta name="twitter:creator" content="@NiftyLeague" />
    <meta name="twitter:image" content={values.images[0]} />
    <link rel="icon" href="/favicon/nl_purple/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon/nl_purple/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon/nl_purple/android-chrome-192x192.png" />
    <link rel="preload" href={defaultFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={headerFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <style is:inline set:html={fontCss} />
  </head>
  <body>
    <slot />
    {telemetryEnabled && <div id="web-telemetry" data-analytics={String(analytics)} hidden />}
    <script>
      import '../runtime/telemetry'
    </script>
  </body>
</html>
