---
import Marketing from '@/layouts/Marketing.astro'
import OptimizedImage from '@nl/ui/custom/optimized-image'
import CommunityConversation from '@/components/CommunityConversation'

import '@/styles/marketing.css'
import styles from '@/styles/community.module.css'

const metadata = {
  title: 'Community',
  description: 'Community comes first at Nifty League',
  openGraph: {
    title: 'Nifty League | Community',
    description: 'Community comes first at Nifty League',
    images: 'https://niftyleague.comhttps://cdn.niftyleague.com/media/img/backgrounds/banner-dark.webp',
  },
}
---
<Marketing metadata={metadata} rootClass="com-pg" canonical="/community">
  <section class="relative min-h-screen">
    <div class="container pt-40 relative flex flex-col md:flex-row z-[2]">
      <div class="w-full md:w-1/2 px-0 text-center md:text-left">
        <h4 class="whitespace-nowrap text-highlight-purple">Nifty League</h4>
        <h2>Community</h2>
        <p class="mt-3">Meet our global community of gamers</p>
      </div>
      <div class="w-full sm:w-2/3 md:w-1/2 xl:w-1/3 relative mx-auto text-center">
        <div class="relative">
          <OptimizedImage
            src="https://cdn.niftyleague.com/media/img/space/moon-satoshi.webp"
            alt="Satoshi moon"
            width={445}
            height={437}
            priority
            sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 67vw"
            class="w-full h-auto"
          />
        </div>
        <div class={styles.moon_grad}>
          <OptimizedImage
            src="https://cdn.niftyleague.com/media/img/gradient/purple-light-grad.svg"
            alt="gradient background"
            width={685}
            height={685}
            sizes="685px"
            priority
          />
        </div>
        <div class="purple-bg-orb orb-top-right"></div>
      </div>
    </div>

    <div class="w-full h-auto absolute -bottom-10 md:-bottom-20">
      <div class="relative">
        <OptimizedImage
          src="https://cdn.niftyleague.com/media/img/space/earth-darkened.webp"
          width={1684}
          height={525}
          alt="Earth"
          sizes="100vw"
          priority
          class="w-full h-auto"
        />
      </div>
      <div class="dark-gradient-overlay"></div>
    </div>
    <span class={styles.earth_grad}>
      <OptimizedImage
        src="https://cdn.niftyleague.com/media/img/gradient/purple-grad.svg"
        alt="Purple eclipse"
        width={704}
        height={704}
        sizes="(min-width: 769px) 80vw, 100vw"
        class="w-full h-auto"
      />
    </span>
  </section>

  <CommunityConversation />

  <section class="section flex sliding-nfts relative overflow-hidden">
    <div class="flex flex-col text-center relative p-0">
      <div class="relative sliding-background-wrapper">
        <div class="sliding-background"></div>
        <div class="dark-gradient-overlay"></div>
      </div>
    </div>
  </section>
</Marketing>
