---
import Marketing from '@/layouts/Marketing.astro'
import LegacyPage from '@/app/(main)/careers/page'
import { metadata as routeMetadata } from '@/app/(main)/careers/layout'
import { DeferredCareersJobs } from '@/components/DeferredCareersSections'
---
<Marketing metadata={routeMetadata} rootClass="career-pg" canonical="/careers">
  <LegacyPage>
  <Fragment slot="webIsland0">
<DeferredCareersJobs client:visible={{ rootMargin: "200px" }} />
  </Fragment>
  </LegacyPage>
</Marketing>
