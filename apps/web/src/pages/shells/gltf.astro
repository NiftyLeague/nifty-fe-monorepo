---
import Base from '../../layouts/Base.astro'
import GltfClient from '../../runtime/GltfClient'
import styles from '@/app/(special-routes)/gltf/[tokenId]/gltf.module.css'
import { DEGEN_2D_IMAGE_URL } from '@/constants/degen-assets'
// The Worker rewrites this poster per token (HTMLRewriter); on static hosts the
// inline script below performs the same correction before the viewer mounts.
const posterBase = DEGEN_2D_IMAGE_URL
---
<Base noindex analytics={false} canonical="/degens">
  <div class={styles.viewer__shell}>
    <div class={styles.initial__image}>
      <img data-gltf-poster class={styles.image} src={`${posterBase}/1.webp`} alt="Nifty DEGEN" width="584" height="640" loading="eager" fetchpriority="high" />
    </div>
    <GltfClient client:only="solid-js"><span slot="fallback" class="sr-only">Loading viewer controls…</span></GltfClient>
  </div>
  <script is:inline define:vars={{ posterBase }}>
    (() => {
      const match = /^\/gltf\/(\d{1,12})\/?$/.exec(window.location.pathname)
      if (!match) return
      const tokenId = match[1]
      const poster = document.querySelector('img[data-gltf-poster]')
      // Animated WebP already covers the leggy degens at this path.
      if (poster) poster.src = `${posterBase}/${tokenId}.webp`
    })()
  </script>
</Base>
