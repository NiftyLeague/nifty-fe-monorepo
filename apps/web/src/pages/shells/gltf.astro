---
import Base from '../../layouts/Base.astro'
import GltfClient from '../../runtime/GltfClient'
import styles from '@/app/(special-routes)/gltf/[tokenId]/gltf.module.css'
import { LEGGIES } from '@/constants/degen-assets'
// The Worker rewrites this poster per token (HTMLRewriter); on static hosts the
// inline script below performs the same correction before the viewer mounts.
const leggies = JSON.stringify(LEGGIES)
---
<Base analytics={false} canonical="/degens">
  <div class={styles.viewer__shell}>
    <div class={styles.initial__image}>
      <img data-gltf-poster src="/img/degens/nfts/1.webp" alt="Nifty DEGEN" width="584" height="640" loading="eager" fetchpriority="high" />
    </div>
    <GltfClient client:only="react"><span slot="fallback" class="sr-only">Loading viewer controls…</span></GltfClient>
  </div>
  <script is:inline define:vars={{ leggies }}>
    (() => {
      const match = /^\/gltf\/(\d{1,12})\/?$/.exec(window.location.pathname)
      if (!match) return
      const tokenId = match[1]
      const extension = JSON.parse(leggies).includes(Number(tokenId)) ? 'gif' : 'webp'
      const poster = document.querySelector('img[data-gltf-poster]')
      if (poster) poster.src = `/img/degens/nfts/${tokenId}.${extension}`
    })()
  </script>
</Base>
