---
import Marketing from '@/layouts/Marketing.astro'
import LegacyPage from '@/app/(main)/degens/page'
import { DeferredConsoleGame } from '@nl/ui/custom/deferred-console-game'
import { ConsoleGameBackdrop } from '@nl/ui/custom/console-game-backdrop'
import { DeferredYouTubeEmbed } from '@nl/ui/custom/deferred-youtube-embed'
import { DeferredDegenSpecialsTable } from '@/components/DeferredDegenSections'
import DegenGallery from '@/components/DegenGallery'
import ThemeBtnGroup from '@nl/ui/custom/theme-button-group'
import { metadata as routeMetadata } from '@/app/(main)/degens/layout'
---
<Marketing metadata={routeMetadata} rootClass="degens-pg" canonical="/degens">
  <LegacyPage>
  <Fragment slot="webIsland0">
<DeferredConsoleGame client:visible={{ rootMargin: "200px" }} loadInteractiveOnViewport activationDelay={1500} deferVideo src="/video/unboxing.mp4">
        <ConsoleGameBackdrop loading="eager" fetchPriority="high" />
      </DeferredConsoleGame>
  </Fragment>
  <Fragment slot="webIsland1">
<DeferredYouTubeEmbed client:visible={{ rootMargin: "200px" }}
                src="https://www.youtube.com/embed/WWLqE1tnf6U"
                title="Nifty League DEGENs"
                className="h-[315px] w-full"
              />
  </Fragment>
  <Fragment slot="webIsland2">
<DeferredDegenSpecialsTable client:visible={{ rootMargin: "200px" }} />
  </Fragment>
  </LegacyPage>
</Marketing>
