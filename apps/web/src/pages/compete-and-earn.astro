---
import Marketing from '@/layouts/Marketing.astro'
import OptimizedImage from '@nl/ui/custom/optimized-image'
import { Separator } from '@nl/ui/base/separator'
import { cx } from '@nl/ui/class-names'
import { DeferredYouTubeEmbed } from '@nl/ui/custom/deferred-youtube-embed'
import ThemeBtnGroup from '@nl/ui/custom/theme-button-group'
import HomeCompeteSection from '@/components/HomeSections/HomeCompeteSection'
import HomeTokenSection from '@/components/HomeSections/HomeTokenSection'
import '@/styles/home.css'
import styles from '@/styles/compete-and-earn.module.css'

const metadata = {
  title: 'NFTL',
  description: 'Compete, earn, and help govern the future of the Nifty League ecosystem.',
  openGraph: {
    title: 'Nifty League | NFTL',
    description: 'Compete, earn, and help govern the future of the Nifty League ecosystem.',
    images: 'https://niftyleague.comhttps://cdn.niftyleague.com/media/img/compete-and-earn/splash.webp',
  },
}
---
<Marketing metadata={metadata} rootClass="compete-pg" canonical="/compete-and-earn">
  <div class="container pt-20">
    <HomeTokenSection client:visible={{ rootMargin: '200px' }} />

    <section class="section flex flex-col-reverse md:flex-row mt-3 md:mt-5 py-5 items-center relative">
      <div class={cx(styles.block, 'w-full md:w-1/2 pr-5')}>
        <OptimizedImage
          src="https://cdn.niftyleague.com/media/img/compete-and-earn/splash.webp"
          alt="Compete and Earn logo"
          width={700}
          height={548}
          priority
          sizes="(min-width: 768px) 50vw, 100vw"
          class="mb-4 w-full max-w-[28rem] h-auto"
        />
        <div class="mb-3">
          <h2 class="heading-look-3 text-highlight-purple">HOW IT WORKS</h2>
        </div>
        <p>
          4–16 players pool NFTL together for a cut-throat battle. The top three finishers take
          home earnings from the pooled pot.
        </p>
      </div>
      <div class="w-full md:w-1/2">
        <div class="relative text-right mb-4 md:mb-0 ps-0 lg:ps-5">
          {/* The embed self-gates on its own IntersectionObserver, so hydrating on
          load only shipped React earlier for no benefit (degens.astro already used
          client:visible for the same component). */}
          <DeferredYouTubeEmbed
            client:visible
            src="https://www.youtube-nocookie.com/embed/wv_fI1PPBi0"
            title="Nifty League Compete & Earn"
            className={styles.video}
          />
        </div>
      </div>
      <div class="purple-bg-orb orb-bottom-right"></div>
    </section>

    <section class="section hidden md:block">
      <h3 class="mt-3 mt-md-5 text-center">GAME MODES</h3>
      <div class={cx(styles.features, 'flex pt-3 md:pt-5 mx-auto relative')}>
        <div class="w-1/3">
          <h4 class={cx(styles.headerCell, 'heading-look-6 text-highlight-purple')}>
            FEATURES:
          </h4>
          <p class={styles.cell}>Requires an invite:</p>
          <p class={styles.cell}>Buy-in:</p>
          <p class={styles.cell}>Region:</p>
          <p class={styles.cell}>Player Number:</p>
        </div>
        <Separator
          orientation="vertical"
          style={{
            height: 'inherit',
            width: 3,
            backgroundColor: 'var(--color-foreground)',
            marginRight: 50,
          }}
        />
        <div class="w-1/3">
          <h4 class={cx(styles.headerCell, 'heading-look-6 text-highlight-purple')}>
            PUBLIC
          </h4>
          <p class={styles.cell}>No</p>
          <p class={styles.cell}>1000 NFTL</p>
          <p class={styles.cell}>Decided by the Host</p>
          <p class={styles.cell}>Decided by the Host</p>
        </div>
        <div class="w-1/3">
          <h4 class={cx(styles.headerCell, 'heading-look-6 text-highlight-purple')}>
            PRIVATE
          </h4>
          <p class={styles.cell}>Yes</p>
          <p class={styles.cell}>Decided by the Host</p>
          <p class={styles.cell}>Decided by the Host</p>
          <p class={styles.cell}>Decided by the Host</p>
        </div>
      </div>

      <ThemeBtnGroup
        className="mt-6 xl:mt-10"
        primary={{ href: 'https://app.niftyleague.com', title: 'PLAY NOW', external: true }}
      />
    </section>

    <HomeCompeteSection />
  </div>
</Marketing>
