---
import Marketing from '@/layouts/Marketing.astro'
import LegacyPage from '@/app/(main)/compete-and-earn/page'
import { DeferredYouTubeEmbed } from '@nl/ui/custom/deferred-youtube-embed'
import styles from '@/app/(main)/compete-and-earn/index.module.css'
import { metadata as routeMetadata } from '@/app/(main)/compete-and-earn/layout'
---
<Marketing metadata={routeMetadata} rootClass="compete-pg" canonical="/compete-and-earn">
  <LegacyPage>
  <Fragment slot="webIsland0">
<DeferredYouTubeEmbed client:visible={{ rootMargin: "200px" }}
              src="https://www.youtube.com/embed/wv_fI1PPBi0"
              title="Nifty League Compete & Earn"
              className={styles.video}
            />
  </Fragment>
  </LegacyPage>
</Marketing>
