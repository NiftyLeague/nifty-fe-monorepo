---
import Marketing from '@/layouts/Marketing.astro'
import LegacyPage from '@/app/(main)/games/page'
import { ViewportVideo } from '@nl/ui/custom/viewport-video'
import { metadata as routeMetadata } from '@/app/(main)/games/layout'
---
<Marketing metadata={routeMetadata} rootClass="games-pg" canonical="/games">
  <LegacyPage>
    <Fragment slot="webIsland0">
      <ViewportVideo
        client:visible={{ rootMargin: '200px' }}
        id="lobby"
        width="100%"
        height="100%"
        muted
        loop
        playsInline
        data-keepplaying
        className="hidden md:block"
        poster="/img/games/smashers/lobby.webp"
        src="/video/lobby.mp4"
      />
    </Fragment>
  </LegacyPage>
</Marketing>
