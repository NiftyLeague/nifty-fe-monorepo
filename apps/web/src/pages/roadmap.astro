---
import Marketing from '@/layouts/Marketing.astro'
import LegacyPage from '@/app/(main)/roadmap/page'
import OptimizedImage from '@nl/ui/custom/optimized-image'
import RoadmapTimeline from '@/components/RoadmapTimeline'
import roadmapStyles from '@/components/RoadmapTimeline/index.module.css'
import satoshiStyles from '@/app/(main)/roadmap/satoshi-right.module.css'
import { metadata as routeMetadata } from '@/app/(main)/roadmap/layout'
---
<Marketing metadata={routeMetadata} rootClass="roadmap-pg" canonical="/roadmap">
  <LegacyPage>
  <Fragment slot="webIsland0">
<RoadmapTimeline client:visible={{ rootMargin: "200px" }} />
  </Fragment>
  </LegacyPage>
</Marketing>
