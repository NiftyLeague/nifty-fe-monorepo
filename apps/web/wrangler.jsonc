{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nifty-league-web-astro",
  "account_id": "90526f277153982742d51be614fb9b40",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/gltf/*",
      "/invite/*",
      "/party/*",
      "/shells/*",
      "/contact",
      "/shop",
      "/collections",
      "/collections/*",
      "/pages",
      "/pages/*",
      "/products",
      "/products/*",
      "/cart",
      "/cart/*",
      "/account/login",
      "/docs",
      "/docs/*",
      "/app",
      "/niftyverse",
      "/niftyverse/*",
      "/blog",
      "/feedback",
      "/snapshot",
      "/tally",
      "/NFTL/supply",
      "/HUB",
      "/OS",
      "/ME",
      "/BLUR",
      "/d/*"
    ]
  },
  "vars": { "DEPLOY_ENV": "production" },
  "observability": { "enabled": true },
  "workers_dev": true
}
