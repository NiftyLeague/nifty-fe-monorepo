{
  "schemaVersion": 1,
  "runCount": 5,
  "buildRunCount": 3,
  "settleMs": 2000,
  "profile": {
    "browser": "Google Chrome headless",
    "viewport": "1365x768 @ 1x",
    "cache": "disabled for every route sample",
    "network": "unthrottled synthetic desktop; compare only with the same profile",
    "interaction": "synthetic click on the configured selector after load",
    "confidence": "synthetic lab data; not a substitute for field RUM p75"
  },
  "routes": [
    {
      "id": "api-root",
      "app": "api",
      "url": "https://api.niftyleague.com/",
      "environment": "production",
      "priority": "P0",
      "interaction": {
        "selector": "body"
      }
    },
    {
      "id": "app-degens",
      "app": "app",
      "url": "https://app.niftyleague.com/degens",
      "environment": "production",
      "priority": "P0",
      "interaction": {
        "selector": "body"
      }
    },
    {
      "id": "docs-overview",
      "app": "docs",
      "url": "https://docs.niftyleague.com/overview/intro",
      "environment": "production",
      "priority": "P1",
      "interaction": {
        "selector": "body"
      }
    },
    {
      "id": "smashers-home",
      "app": "smashers",
      "url": "https://niftysmashers.com/",
      "environment": "production",
      "priority": "P0",
      "interaction": {
        "selector": "body"
      }
    },
    {
      "id": "web-home",
      "app": "web",
      "url": "https://niftyleague.com/",
      "environment": "production",
      "priority": "P0",
      "interaction": {
        "selector": "body"
      }
    }
  ],
  "builds": [
    {
      "app": "api",
      "cleanPaths": ["apps/api/dist", "apps/api/api/.app"],
      "command": ["bun", "--filter", "api", "build"]
    },
    {
      "app": "app",
      "cleanPaths": ["apps/app/.vercel/output"],
      "command": ["bun", "--filter", "app", "build"]
    },
    {
      "app": "docs",
      "cleanPaths": ["apps/docs/dist", "apps/docs/.astro"],
      "command": ["bun", "--filter", "docs", "build"]
    },
    {
      "app": "smashers",
      "cleanPaths": ["apps/smashers/dist", "apps/smashers/.astro"],
      "command": ["bun", "--filter", "smashers", "build"]
    },
    {
      "app": "web",
      "cleanPaths": ["apps/web/dist", "apps/web/.astro"],
      "command": ["bun", "--filter", "web", "build"]
    }
  ]
}
