{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    "**/.turbo/**",
    "**/src/types/typechain/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/.app/**",
    ".agents/**",
    "**/.astro/**",
    "**/.wrangler/**",
    "**/.web-images/**",
    "**/routeTree.gen.ts",
    "**/.vercel/**"
  ],
  "overrides": [
    {
      "files": ["packages/playfab/src/**/*.ts"],
      "rules": {
        "triple-slash-reference": "off"
      }
    }
  ]
}
