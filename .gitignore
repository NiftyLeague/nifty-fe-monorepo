# Repository-specific rules
# Generated SEO files belong to the app that serves them, never to the shared
# assets directory. Every Astro app uses ../../assets as its publicDir, so a file
# left here is copied into each app's output: stale staging files from the
# pre-migration build sat here and silently replaced apps/web's own sitemap in
# local builds.
assets/robots.txt
assets/sitemap.xml
assets/sitemap-*.xml
assets/sitemap-index.xml
.zcode/
test-results/
# Cloudflare Workers local state
.wrangler/
# Cloudflare cf CLI build output (Build Output Specification)
.cloudflare/
