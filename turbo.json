{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": ["CI", "VERCEL_ENV"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"],
      "outputs": ["dist/**"]
    },
    "app#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../config/image-device-sizes.ts",
        "../../packages/contracts/src/**",
        "../../packages/contracts/package.json",
        "../../packages/imx-passport/src/**",
        "../../packages/imx-passport/package.json",
        "../../packages/sentry-client/src/**",
        "../../packages/sentry-client/package.json",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!src/types/typechain/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**"
      ],
      "env": [
        "CI",
        "NEXT_RUNTIME",
        "NEXT_PUBLIC_*",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VERCEL_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "api#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/contracts/src/**",
        "../../packages/contracts/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**"
      ],
      "env": [
        "NODE_CONFIG_TS_DIR",
        "PORT",
        "VERCEL",
        "ETH_NETWORK",
        "ETH_ACCOUNT_PRIVATE_KEY",
        "TESTNET_ALCHEMY_API_KEY",
        "MAINNET_ALCHEMY_API_KEY",
        "ETHERSCAN_API_KEY",
        "OPENSEA_API_KEY",
        "WEBHOOK_SECRET",
        "BLOCKNATIVE_API_KEY_DEGENS",
        "S3_ACCESS_ID",
        "S3_SECRET",
        "UNITY_IMAGE_GENERATOR_BASE_URL",
        "UNITY_IMAGE_GENERATOR_SECRET",
        "UNITY_IMAGE_GENERATOR_VERSION",
        "NFT_STORAGE_KEY",
        "PINATA_API_KEY",
        "PINATA_API_SECRET",
        "TESTNET_IMX_API_KEY",
        "MAINNET_IMX_API_KEY",
        "ORGANIZATION_ID",
        "TESTNET_LEGACY_PROJECT_ID",
        "MAINNET_LEGACY_PROJECT_ID",
        "TESTNET_COLLECTION_CONTRACT_ADDRESS",
        "MAINNET_COLLECTION_CONTRACT_ADDRESS"
      ],
      "outputs": ["dist/**", "api/.app/**", "api/config/**"]
    },
    "docs#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**"
      ],
      "env": ["ALGOLIA_API_KEY", "ALGOLIA_APP_ID"],
      "outputs": ["build/**", ".docusaurus/**"]
    },
    "smashers#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../config/image-device-sizes.ts",
        "../../packages/playfab/src/**",
        "../../packages/playfab/package.json",
        "../../packages/sentry-client/src/**",
        "../../packages/sentry-client/package.json",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!../../packages/playfab/src/test-mock-sdk.ts",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**"
      ],
      "env": [
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "CI",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "GITHUB_ACTIONS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PHASE",
        "NEXT_RUNTIME",
        "NEXT_PUBLIC_*",
        "NEXTAUTH_SECRET",
        "PLAYFAB_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "TWITCH_CLIENT_ID",
        "TWITCH_CLIENT_SECRET",
        "VERCEL_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "template#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "web#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../config/image-device-sizes.ts",
        "../../packages/sentry-client/src/**",
        "../../packages/sentry-client/package.json",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**"
      ],
      "env": [
        "CI",
        "EDGE_CONFIG",
        "NEXT_RUNTIME",
        "NEXT_PUBLIC_*",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VERCEL_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "clean": { "cache": false },
    "lint": { "env": ["NEXT_PUBLIC_VERCEL_ENV"] },
    "lint:fix": { "env": ["NEXT_PUBLIC_VERCEL_ENV"] },
    "api#lint": {
      "env": [
        "NODE_CONFIG_TS_DIR",
        "PORT",
        "VERCEL",
        "ETH_NETWORK",
        "WEBHOOK_SECRET",
        "BASE_URL",
        "AUDIT_NETWORK",
        "VERCEL_SCOPE",
        "VERCEL_TOKEN"
      ]
    },
    "format": {},
    "type-check": {},
    "api#type-check": {
      "env": ["NODE_CONFIG_TS_DIR", "PORT", "VERCEL", "ETH_NETWORK", "WEBHOOK_SECRET"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },
    "api#test": {
      "env": ["NODE_CONFIG_TS_DIR", "PORT", "VERCEL", "ETH_NETWORK", "WEBHOOK_SECRET"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },
    "format:check": { "dependsOn": ["^format:check"], "cache": true }
  }
}
