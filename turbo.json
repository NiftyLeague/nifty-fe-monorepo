{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": ["CI", "VITE_DEPLOY_ENV"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"],
      "outputs": ["dist/**"]
    },
    "app#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/contracts/src/**",
        "../../packages/contracts/package.json",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.stories.*",
        "!**/*.story.*",
        "!**/__tests__/**",
        "!../../packages/ui/src/**/*.test.*",
        "!../../packages/ui/src/**/*.spec.*",
        "!../../packages/ui/src/**/*.stories.*",
        "!../../packages/ui/src/**/*.story.*",
        "!../../packages/ui/src/**/__tests__/**"
      ],
      "env": ["CI", "VITE_*", "VITE_DEPLOY_ENV"],
      "outputs": [".output/**"]
    },
    "api#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/contracts/src/**",
        "../../packages/contracts/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.stories.*",
        "!**/*.story.*",
        "!**/__tests__/**"
      ],
      "env": [
        "NODE_CONFIG_TS_DIR",
        "PORT",
        "ETH_NETWORK",
        "ETH_ACCOUNT_PRIVATE_KEY",
        "TESTNET_ALCHEMY_API_KEY",
        "MAINNET_ALCHEMY_API_KEY",
        "ETHERSCAN_API_KEY",
        "OPENSEA_API_KEY",
        "WEBHOOK_SECRET",
        "BLOCKNATIVE_API_KEY_DEGENS",
        "R2_ENDPOINT",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "UNITY_IMAGE_GENERATOR_BASE_URL",
        "UNITY_IMAGE_GENERATOR_SECRET",
        "UNITY_IMAGE_GENERATOR_VERSION",
        "NFT_STORAGE_KEY",
        "PINATA_API_KEY",
        "PINATA_API_SECRET",
        "TESTNET_IMX_API_KEY",
        "MAINNET_IMX_API_KEY",
        "ORGANIZATION_ID",
        "TESTNET_LEGACY_PROJECT_ID",
        "MAINNET_LEGACY_PROJECT_ID",
        "TESTNET_COLLECTION_CONTRACT_ADDRESS",
        "MAINNET_COLLECTION_CONTRACT_ADDRESS"
      ],
      "outputs": ["dist/**"]
    },
    "docs#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../assets/**",
        "../../packages/astro-config/**",
        "../../packages/astro-config/package.json",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.stories.*",
        "!**/*.story.*",
        "!**/__tests__/**",
        "!../../packages/ui/src/**/*.test.*",
        "!../../packages/ui/src/**/*.spec.*",
        "!../../packages/ui/src/**/*.stories.*",
        "!../../packages/ui/src/**/*.story.*",
        "!../../packages/ui/src/**/__tests__/**"
      ],
      "env": ["PUBLIC_ALGOLIA_API_KEY", "PUBLIC_ALGOLIA_APP_ID"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "smashers#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../assets/**",
        "../../packages/astro-config/**",
        "../../packages/astro-config/package.json",
        "../../packages/playfab/src/**",
        "../../packages/playfab/package.json",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!../../packages/playfab/src/test-mock-sdk.ts",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.stories.*",
        "!**/*.story.*",
        "!**/__tests__/**",
        "!../../packages/ui/src/**/*.test.*",
        "!../../packages/ui/src/**/*.spec.*",
        "!../../packages/ui/src/**/*.stories.*",
        "!../../packages/ui/src/**/*.story.*",
        "!../../packages/ui/src/**/__tests__/**",
        "!../../packages/playfab/src/**/*.test.*",
        "!../../packages/playfab/src/**/*.spec.*",
        "!../../packages/playfab/src/**/*.stories.*",
        "!../../packages/playfab/src/**/*.story.*",
        "!../../packages/playfab/src/**/__tests__/**"
      ],
      "env": [
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "CI",
        "ENABLE_EXPERIMENTAL_COREPACK",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "GITHUB_ACTIONS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "PLAYFAB_API_KEY",
        "PUBLIC_*",
        "SESSION_SECRET",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "TWITCH_CLIENT_ID",
        "TWITCH_CLIENT_SECRET",
        "NODE_ENV"
      ],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../assets/**",
        "../../packages/astro-config/**",
        "../../packages/astro-config/package.json",
        "../../packages/ui/src/**",
        "../../packages/ui/package.json",
        ".env*",
        "!.env.example",
        "!**/README.md",
        "!**/CHANGELOG.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.stories.*",
        "!**/*.story.*",
        "!**/__tests__/**",
        "!../../packages/ui/src/**/*.test.*",
        "!../../packages/ui/src/**/*.spec.*",
        "!../../packages/ui/src/**/*.stories.*",
        "!../../packages/ui/src/**/*.story.*",
        "!../../packages/ui/src/**/__tests__/**"
      ],
      "env": ["CI", "PUBLIC_DEPLOY_ENV", "PUBLIC_TELEMETRY", "PUBLIC_INFURA_ID"],
      "outputs": ["dist/**", ".worker-build/**", ".web-images/**"]
    },
    "clean": {
      "cache": false
    },
    "lint": {},
    "lint:fix": {},
    "api#lint": {
      "env": [
        "AUDIT_NETWORK",
        "BASE_URL",
        "BUN_BINARY",
        "ETH_NETWORK",
        "NODE_CONFIG_TS_DIR",
        "PORT",
        "RUN_LIVE_TESTS",
        "WEBHOOK_SECRET"
      ]
    },
    "@nl/playfab#lint": {
      "env": ["PUBLIC_PLAYFAB_TITLE_ID", "PLAYFAB_API_KEY"]
    },
    "format": {},
    "type-check": {},
    "api#type-check": {
      "env": ["NODE_CONFIG_TS_DIR", "PORT", "ETH_NETWORK", "WEBHOOK_SECRET"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "../../test/**", ".env*", "!.env.example"]
    },
    "api#test": {
      "env": ["NODE_CONFIG_TS_DIR", "PORT", "ETH_NETWORK", "WEBHOOK_SECRET"],
      "inputs": ["$TURBO_DEFAULT$", "../../test/**", ".env*", "!.env.example"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
    },
    "format:check": {
      "dependsOn": ["^format:check"],
      "cache": true
    },
    "cf:build": {
      "dependsOn": [],
      "outputs": ["dist/**", ".output/**"]
    },
    "web#cf:build": {
      "env": ["CI", "PUBLIC_DEPLOY_ENV", "PUBLIC_TELEMETRY", "PUBLIC_INFURA_ID"],
      "outputs": ["dist/**"]
    },
    "app#cf:build": {
      "env": ["CI", "VITE_*", "VITE_DEPLOY_ENV"],
      "outputs": [".output/**"]
    },
    "smashers#cf:build": {
      "env": [
        "APPLE_CLIENT_ID",
        "APPLE_CLIENT_SECRET",
        "CI",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "GITHUB_ACTIONS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "PLAYFAB_API_KEY",
        "PUBLIC_*",
        "SESSION_SECRET",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "TWITCH_CLIENT_ID",
        "TWITCH_CLIENT_SECRET",
        "NODE_ENV"
      ],
      "outputs": ["dist/**"]
    },
    "docs#cf:build": {
      "env": [
        "ALGOLIA_API_KEY",
        "ALGOLIA_APP_ID",
        "PUBLIC_ALGOLIA_API_KEY",
        "PUBLIC_ALGOLIA_APP_ID"
      ],
      "outputs": ["dist/**"]
    }
  }
}
