{
  "name": "nifty-fe-monorepo",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "act-ci": "act --container-architecture linux/amd64 -P ubuntu-latest=-self-hosted -s GITHUB_TOKEN --var-file .env.act --secret-file .env.act -W '.github/workflows/ci.yml'",
    "add-ui": "bun --filter ui add-component $@",
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "format": "turbo format",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "migrate-ui": "bun --filter ui migrate",
    "prepare": "husky && bun run symlinks",
    "symlinks": "bun exec .sh/symlinks.sh",
    "sync-node-versions": "bun exec .sh/sync-node-versions.sh",
    "type-check": "turbo type-check",
    "type:check": "turbo type-check",
    "test": "turbo test",
    "start": "turbo start",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "@nl/eslint-config": "workspace:*",
    "@nl/prettier-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "semver": "^7.8.5",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.5",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "bnc-sdk>crypto-es": "^2.1.0",
    "zod": "^4.4.3"
  },
  "trustedDependencies": [
    "@axelar-network/axelarjs-sdk",
    "@opensea/seaport-js",
    "@prisma/engines",
    "@reown/appkit",
    "@sentry/cli",
    "@swc/core",
    "@tailwindcss/oxide",
    "bufferutil",
    "core-js",
    "core-js-pure",
    "esbuild",
    "keccak",
    "prisma",
    "protobufjs",
    "sharp",
    "unrs-resolver",
    "utf-8-validate"
  ],
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}