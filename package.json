{
  "name": "nifty-fe-monorepo",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "act-ci": "act --container-architecture linux/amd64 -P ubuntu-latest=-self-hosted -s GITHUB_TOKEN --var-file .env.act --secret-file .env.act -W '.github/workflows/ci.yml'",
    "add-ui": "bun --filter ui add-component $@",
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,md,mdx,json,yml,yaml}\" --ignore-path .prettierignore",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "migrate-ui": "bun --filter ui migrate",
    "prepare": "husky || true && bun symlinks",
    "symlinks": "bun exec .sh/symlinks.sh",
    "sync-node-versions": "bun exec .sh/sync-node-versions.sh",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage:workspaces": "turbo test:coverage",
    "test:watch": "bun test --watch",
    "type-check": "turbo type-check",
    "type:check": "turbo type-check",
    "start": "turbo run dev"
  },
  "devDependencies": {
    "@nl/eslint-config": "workspace:*",
    "@nl/prettier-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@happy-dom/global-registrator": "^18.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "semver": "^7.8.5",
    "syncpack": "^13.0.4",
    "turbo": "^2.10.5",
    "typescript": "~5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}