{
  "name": "nifty-fe-monorepo",
  "version": "1.0.0",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.0",
    "@nl/eslint-config": "workspace:*",
    "@nl/prettier-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "semver": "^7.8.5",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.5",
    "typescript": "~5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "24.18.0"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "act-ci": "act --container-architecture linux/amd64 -P ubuntu-latest=-self-hosted -s GITHUB_TOKEN --var-file .env.act --secret-file .env.act -W '.github/workflows/ci.yml'",
    "add-ui": "bun --filter ui add-component $@",
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,md,mdx,json,yml,yaml}\" --ignore-path .prettierignore",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "migrate-ui": "bun --filter ui migrate",
    "install:ci": "bun install --frozen-lockfile",
    "install": "bun install --frozen-lockfile --ignore-scripts && bun run prepare",
    "prepare": "husky || true && bun symlinks",
    "symlinks": "bun exec .sh/symlinks.sh",
    "sync-node-versions": "bun exec .sh/sync-node-versions.sh",
    "test": "turbo test",
    "test:coverage": "bun test --isolate --coverage",
    "test:coverage:workspaces": "turbo test:coverage",
    "test:watch": "bun test --watch",
    "type-check": "turbo type-check",
    "type:check": "turbo type-check",
    "start": "turbo run dev"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@axelar-network/axelarjs-sdk": "^0.21.0",
    "@cowprotocol/cow-sdk": "^9.2.2",
    "@imtbl/sdk": "^2.21.0",
    "@types/three": "^0.185.1",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/extensions": "^2.19.0",
    "@x402/svm": "^2.19.0",
    "lucide-react": "^1.25.0",
    "react-hook-form": "^7.82.0",
    "react-intl": "^10.1.18",
    "react-unity-webgl": "~10.2.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "wagmi": "^3.7.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "overrides": {
    "adm-zip": "0.5.16",
    "fast-uri": "4.0.1",
    "serialize-javascript": "6.0.2",
    "ws": "8.18.2"
  }
}
