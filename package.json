{
  "name": "nifty-fe-monorepo",
  "version": "1.2.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "act-ci": "act --container-architecture linux/amd64 -P ubuntu-latest=-self-hosted -s GITHUB_TOKEN --var-file .env.act --secret-file .env.act -W '.github/workflows/ci.yml'",
    "add-ui": "bun --filter ui add-component $@",
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,md,mdx,json,yml,yaml}\" --ignore-path .prettierignore",
    "install:ci": "bun install --frozen-lockfile",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "migrate-ui": "bun --filter ui migrate",
    "prepare": "bun symlinks",
    "start": "turbo run dev",
    "symlinks": "bun exec .sh/symlinks.sh",
    "sync-node-versions": "bun exec .sh/sync-node-versions.sh",
    "test": "turbo test",
    "test:unit": "bun run test:coverage",
    "test:coverage": "bun test --isolate --coverage --max-concurrency=1",
    "test:coverage:workspaces": "turbo test:coverage",
    "test:watch": "bun test --watch",
    "type-check": "turbo type-check",
    "type:check": "turbo type-check"
  },
  "dependencies": {
    "@axelar-network/axelarjs-sdk": "^0.21.0",
    "@cowprotocol/cow-sdk": "^9.2.6",
    "@google/model-viewer": "^4.3.1",
    "@imtbl/sdk": "^2.24.4",
    "@types/three": "^0.185.3",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/extensions": "^2.20.0",
    "@x402/svm": "^2.20.0",
    "lucide-react": "^1.28.0",
    "react-hook-form": "^7.84.0",
    "react-intl": "^10.1.19",
    "react-unity-webgl": "~10.2.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1",
    "wagmi": "^3.7.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@nl/eslint-config": "workspace:*",
    "@nl/prettier-config": "workspace:*",
    "@nl/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.8",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "24.18.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "overrides": {
    "adm-zip": "0.5.16",
    "fast-uri": "4.1.2",
    "serialize-javascript": "6.0.2",
    "ws": "8.18.2",
    "undici": "6.28.0",
    "ip-address": "10.3.1",
    "tmp": "0.2.3",
    "brace-expansion": "5.0.9",
    "crypto-es": "2.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "protobufjs": "7.5.0",
    "js-yaml": "4.3.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
